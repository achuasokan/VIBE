<footer class="bg-[#0B1120] text-slate-400 font-sans pt-16 pb-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Brand & Newsletter Card -->
      <div class="bg-[#111827] border border-slate-800 rounded-3xl p-6 sm:p-10 mb-14 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 shadow-xl">
        <div class="max-w-md">
          <a href="/" class="inline-block transition-transform duration-200 hover:scale-[1.02]">
            <img src="../../images/vibe-logo.png" alt="Vibe Audio" class="w-24 opacity-95 hover:opacity-100 transition-opacity" />
          </a>
          <p class="text-xs text-slate-400 mt-2.5 leading-relaxed font-normal">
            Engineered for acoustic purity. High-fidelity wireless audio, studio-grade acoustics, and precision soundscapes.
          </p>
        </div>

        <!-- Sleek High-Contrast Newsletter Box -->
        <div class="w-full lg:w-auto">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            <div class="relative flex-grow">
              <i class="fa-regular fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
              <input type="email" placeholder="Enter your email address..." class="bg-slate-900 border border-slate-700/80 text-slate-200 placeholder-slate-500 text-xs pl-10 pr-4 py-3 rounded-full outline-none focus:ring-2 focus:ring-slate-500/20 focus:border-slate-500 w-full sm:w-72 transition-all" />
            </div>
            <button type="button" class="bg-white hover:bg-slate-200 text-slate-950 text-xs font-bold px-6 py-3 rounded-full transition-all duration-200 shadow-md hover:shadow-lg flex-shrink-0">
              Subscribe
            </button>
          </div>
          <span class="text-[11px] text-slate-500 mt-2 block sm:text-left">
            Be the first to discover new acoustic launches and member exclusives.
          </span>
        </div>
      </div>

      <!-- Links Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-10 mb-14">
        
        <!-- Shop Categories -->
        <div>
          <h6 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Shop Products</h6>
          <ul class="space-y-2.5">
            <% categories.forEach(category => { %>
                <li>
                  <a href="/category/<%=category._id%>" class="text-xs text-slate-400 hover:text-white font-medium transition-colors">
                    <%=category.name%>
                  </a>
                </li>
            <% }) %>
            <li>
              <a href="/all/products" class="text-xs text-slate-200 hover:text-white font-bold transition-colors inline-flex items-center gap-1.5 pt-1">
                All Products <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </li>
          </ul>
        </div>

        <!-- Customer Care -->
        <div>
          <h6 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Customer Care</h6>
          <ul class="space-y-2.5 text-xs text-slate-400 font-medium">
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">Track Your Order</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">7-Day Replacement Policy</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">1-Year Warranty Claim</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">Shipping & Delivery Rates</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">Help Center & FAQs</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">GST Invoice Download</a></li>
          </ul>
        </div>

        <!-- Company -->
        <div>
          <h6 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Company</h6>
          <ul class="space-y-2.5 text-xs text-slate-400 font-medium">
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">About VIBE</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">Acoustic Philosophy</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">Store Locator</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">Careers & Culture</a></li>
            <li><a href="javascript:void(0)" class="hover:text-white transition-colors">Corporate Inquiries</a></li>
          </ul>
        </div>

        <!-- Connect With Us -->
        <div>
          <h6 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Connect With Us</h6>
          
          <!-- Social Icons with 100% Reliable SVGs and FA -->
          <div class="flex space-x-3 mb-5">
            <!-- X / Twitter Official SVG -->
            <a href="javascript:void(0)" aria-label="X Twitter" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-white hover:text-slate-950 text-slate-300 flex items-center justify-center transition-all duration-200 border border-slate-700/60 shadow-sm">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            
            <!-- Instagram -->
            <a href="javascript:void(0)" aria-label="Instagram" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-white hover:text-slate-950 text-slate-300 flex items-center justify-center transition-all duration-200 border border-slate-700/60 shadow-sm">
              <i class="fa-brands fa-instagram text-xs"></i>
            </a>

            <!-- YouTube -->
            <a href="javascript:void(0)" aria-label="YouTube" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-white hover:text-slate-950 text-slate-300 flex items-center justify-center transition-all duration-200 border border-slate-700/60 shadow-sm">
              <i class="fa-brands fa-youtube text-xs"></i>
            </a>

            <!-- LinkedIn -->
            <a href="javascript:void(0)" aria-label="LinkedIn" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-white hover:text-slate-950 text-slate-300 flex items-center justify-center transition-all duration-200 border border-slate-700/60 shadow-sm">
              <i class="fa-brands fa-linkedin-in text-xs"></i>
            </a>
          </div>

          <div class="text-[11px] text-slate-400 space-y-1">
            <p class="font-semibold text-slate-200">Dedicated Acoustic Support</p>
            <p>Mon - Sat: 9:00 AM - 6:00 PM IST</p>
            <p class="text-slate-500">Email: support@vibeaudio.com</p>
          </div>
        </div>
      </div>

      <!-- Trust Badges & Safe Checkout Row -->
      <div class="pt-8 border-t border-slate-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
        <div class="flex items-center gap-4 flex-wrap justify-center sm:justify-start text-[11px] text-slate-400">
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-lock text-slate-300"></i> 256-Bit SSL Encrypted</span>
          <span class="hidden sm:inline text-slate-700">•</span>
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-check-double text-slate-300"></i> 100% Genuine Products</span>
          <span class="hidden sm:inline text-slate-700">•</span>
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-bolt text-slate-300"></i> Instant Dispatch</span>
        </div>

        <div class="flex items-center space-x-6 text-[11px] text-slate-500">
          <a href="javascript:void(0)" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
          <a href="javascript:void(0)" class="hover:text-slate-300 transition-colors">Terms of Sale</a>
          <a href="javascript:void(0)" class="hover:text-slate-300 transition-colors">Security</a>
        </div>
      </div>

      <!-- Bottom Copyright Line -->
      <div class="pt-6 text-center text-[11px] text-slate-500">
        <p>© 2024 VIBE Audio Innovations Inc. All rights reserved. Designed for acoustic perfection.</p>
      </div>

    </div>
  </footer>